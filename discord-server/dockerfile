
FROM node:22-alpine

WORKDIR /app

# Instala as dependências do servidor
COPY discordserver/package.json discordserver/package-lock.json ./discordserver/

WORKDIR /app/discordserver
RUN npm ci --omit=dev

# Copia o código do servidor
COPY discordserver/server.js ./

# Prepara os arquivos públicos do site
WORKDIR /app
RUN mkdir -p /app/public
COPY index.html style.css script.js ./public/


ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["node", "--use-system-ca", "/app/discordserver/server.js"]
